# Pretix (Phase 2) — copy to infra/pretix/pretix.env. NEVER commit real values.
# Reference: https://docs.pretix.eu/en/latest/admin/installation/docker_smallscale.html

PRETIX_DATABASE_BACKEND=postgresql
PRETIX_DATABASE_NAME=pretix
PRETIX_DATABASE_USER=replace-with-db-user
PRETIX_DATABASE_PASSWORD=replace-with-strong-password
PRETIX_DATABASE_HOST=postgres

PRETIX_REDIS_LOCATION=redis://redis:6379/0
PRETIX_REDIS_SESSIONS=true

# Celery broker — use Redis DB 1 (DB 0 is used for cache/sessions above).
# Without this, Celery defaults to RabbitMQ (amqp://) which is not in the stack.
PRETIX_CELERY_BROKER=redis://redis:6379/1

PRETIX_PRETIX_INSTANCE_NAME=Events Platform (dev)
PRETIX_PRETIX_URL=http://localhost:8345
PRETIX_PRETIX_CURRENCY=GBP

# Dev only: allow Docker-internal hostnames (e.g. "pretix") to reach the API.
# In production, set SITE_URL to the real domain and remove this.
PRETIX_DEBUG=true

# Mail (dev): point at a local catcher or console backend.
PRETIX_MAIL_FROM=tickets@localhost

# Stripe (test mode) — configured per-EVENT in the Pretix control panel
# (event → Settings → Payment → Stripe; plugin enablement + keys are not
# exposed via the REST API). These env vars are an alternative for global
# defaults; the per-event control-panel config is the primary path.
# NEVER commit real keys.
# PRETIX_STRIPE_TEST_SECRET_KEY=sk_test_xxx
# PRETIX_STRIPE_TEST_PUBLISHABLE_KEY=pk_test_xxx

# Webhook shared secret — used by our Next.js webhook handler to verify
# Pretix webhook signatures. Set the same value in apps/web/.env as
# PRETIX_WEBHOOK_SECRET. Generate with: openssl rand -hex 32
PRETIX_WEBHOOK_SECRET=replace-with-shared-secret

# Internal admin channel — the pretix-admin service (admin_server.py) serves
# organizer payment-settings writes on the private Docker network. This token
# authenticates callers; set the SAME value in apps/web/.env(.local) as
# PRETIX_ADMIN_TOKEN. Generate with: openssl rand -hex 32
PRETIX_ADMIN_TOKEN=replace-with-shared-secret

# Pretix API URL — used by the onboarding CLI (apps/cli) for REST API calls
# (events, products, quotas, webhooks). Organizer + token creation uses a
# Django management command via docker exec (no admin token needed).
PRETIX_API_URL=http://localhost:8345/api/v1

# Docker container name for the Pretix container (used by docker exec).
# Dev: events-platform-pretix-1 · Prod: selfstub-prod-pretix-1
PRETIX_CONTAINER=events-platform-pretix-1

# --- Production notes (values live ONLY in /srv/apps/selfstub/infra/pretix/pretix.env) ---
# PRETIX_DEBUG MUST be absent or false in production.
# Override the cfg url if the tickets hostname changes:
# PRETIX_PRETIX_URL=https://tickets.selfstub.com
# SMTP — required in prod so buyers receive their PDF/QR ticket emails
# (the dev console backend must NOT be used in production):
# PRETIX_MAIL_HOST=localhost
# PRETIX_MAIL_PORT=587
# PRETIX_MAIL_USER=
# PRETIX_MAIL_PASSWORD=
# PRETIX_MAIL_FROM=tickets@selfstub.com
# The prod API URL for the onboarding CLI (HTTPS, publicly reachable):
# PRETIX_API_URL=https://tickets.selfstub.com/api/v1
